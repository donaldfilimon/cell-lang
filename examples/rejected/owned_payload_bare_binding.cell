// EXPECT: currently-rejected
// Violates: an owning payload binding must say its mode (SPEC 3.4,
// 2026-09-17).
//
// `Result<String, Int32>` carries an owning String, so `Ok(s)` would not
// say whether the arm takes the buffer or borrows it. `cell check` reports
// `'Ok(s)' on an owning payload must say 'owned' or 'shared'`.

pub fn str_len(shared s: String) -> Int;

pub fn length(owned r: Result<String, Int32>) -> Int {
    return match r {
        Ok(s) => str_len(s),
        Err(_) => 0,
    }
}
