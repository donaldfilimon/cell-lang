// EXPECT: currently-accepted
// Violates: docs/OWNERSHIP.md R8 (a borrow may not outlive its referent).
//
// Cell has no lifetime parameters, so a returned borrow cannot be proven to
// outlive the call. Return an `owned` or `arc` value instead.

pub struct Buffer { copy len: Int }

pub fn peek(shared b: Buffer) -> shared Buffer {
    return b
}
