// EXPECT: currently-rejected
// Violates: an owning payload binding must say its mode (SPEC 3.4,
// sub-project 3, 2026-09-17).
//
// `Result<Int, String>` carries an owning String error, so `Err(e)` would not
// say whether the arm takes the buffer or borrows it. `cell check` reports
// `'Err(e)' on an owning payload must say 'owned' or 'shared'`.

pub fn str_len(shared s: String) -> Int;

pub fn length(owned r: Result<Int, String>) -> Int {
    return match r {
        Ok(v) => v,
        Err(e) => str_len(e),
    }
}
