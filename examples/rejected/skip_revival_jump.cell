// EXPECT: currently-rejected
// Violates: docs/OWNERSHIP.md R2.a (a move inside a loop is a use-after-move
// on the next iteration, or after the loop), on paths the body-end check
// never saw.
//
// THIS FILE PINS A HOLE THAT WAS LIVE. Every function below was ACCEPTED by
// `cell check` (exit 0) at 05116dc and aborted under AddressSanitizer with
// `attempting double-free` (exit 134) when run through `cell run` with
// `CC` set to a `cc -fsanitize=address -g` wrapper. For the first shape both
// frees happened inside `cell_take`, and the emitted C had no
// `cell_string_free(&v)` at all, so the fault was in borrowck, not in the
// drop pass.
//
// R2.a used to be checked at exactly one point, the fall-through end of the
// body, against an index range of the `dead` list. Five paths escaped it:
//
//   skip_continue   a `continue` between the move and the revival reaches
//                   the next iteration with `v` moved.
//   skip_break_use  a `break` between the move and the revival leaves the
//                   loop with `v` moved, and the use after the loop reads it.
//   cond_move       the final, failing condition evaluation moves `v`, and
//                   the use after the loop reads it.
//   swap_hide       reviving `a` (moved before the loop) inside the body
//                   `swapRemove`d the entry for `b`'s in-body move below the
//                   index the body-end check started from.
//   zero_iter       a body that revives `v` may run zero times, so after the
//                   loop `v` is still the value moved before it.
//
// The first three came from a design brief; the last two were found by
// measurement while fixing them. Measured after the fix, one error per
// function:
//
//   skip_continue   error: 'v' is moved inside a loop, so the next iteration
//                          would use it after the move          (at take(v))
//                   note: this 'continue' is reached before 'v' is assigned
//                         again
//   skip_break_use  error: use of 'v' after it was moved  (at the final take)
//                   note: 'v' was moved here by the call to 'take'
//   cond_move       error: use of 'v' after it was moved  (at the final take)
//                   note: 'v' was moved here by the call to 'consume'
//   swap_hide       error: 'b' is moved inside a loop, so the next iteration
//                          would use it after the move          (at take(b))
//                   note: 'b' is declared outside this loop; assign to it
//                         before the end of the body to revive it
//   zero_iter       error: use of 'v' after it was moved  (at the final take)
//                   note: 'v' was moved here by the call to 'take' (the move
//                         before the loop)
//
// The fix is conservative: a `continue` taken after a move is refused even
// when the next iteration assigns the place before reading it.

pub fn take(owned s: String) { }

pub fn consume(owned s: String) -> Bool { return false }

pub fn skip_continue(copy n: Int) {
    var owned v: String = "aaaaaaaa"
    var i = 0
    while i < 3 {
        i = i + 1
        take(v)
        if i < n {
            continue
        }
        v = "bbbbbbbb"
    }
}

pub fn skip_break_use(copy n: Int) {
    var owned v: String = "aaaaaaaa"
    var i = 0
    while i < 3 {
        i = i + 1
        take(v)
        if i > n {
            break
        }
        v = "bbbbbbbb"
    }
    take(v)
}

pub fn cond_move() {
    var owned v: String = "aaaaaaaa"
    while consume(v) {
        v = "bbbbbbbb"
    }
    take(v)
}

pub fn swap_hide(copy n: Int) {
    var owned a: String = "aaaaaaaa"
    var owned b: String = "bbbbbbbb"
    take(a)
    var i = 0
    while i < n {
        i = i + 1
        take(b)
        a = "cccccccc"
    }
}

pub fn zero_iter(copy n: Int) {
    var owned v: String = "aaaaaaaa"
    take(v)
    var i = 0
    while i < n {
        i = i + 1
        v = "bbbbbbbb"
    }
    take(v)
}
