// EXPECT: currently-accepted
// Violates: docs/SPEC.md sections 2.6 and 2.7 (literal forms).
//
// The lexer reads decimal digits and stops. So:
//   0x1F   lexes as the integer 0 followed by the identifier x1F
//   1_000  lexes as the integer 1 followed by the identifier _000
//   1e9    lexes as the integer 1 followed by the identifier e9
//
// Every one of these passes `cell check` with exit 0 and emits a DIFFERENT
// NUMBER than the one written. Measured: `let copy a = 0x1F` emits
// `int64_t a = 0; x1F;`.
//
// A conforming implementation must either support these forms or reject them.
// Silently producing a different number is not an option.

pub fn f() {
    let copy a = 0x1F
    let copy b = 1_000
    let copy c = 1e9
}
