// EXPECT: currently-rejected
// Violates: docs/OWNERSHIP.md R2 (use after move).
//
// `take` consumes `buf`, so `buf` is dead afterward and the second call is a
// use-after-move. `cell check` reports `use of 'buf' after it was moved` at
// the second call.

pub struct Buffer { copy len: Int }

pub fn take(owned b: Buffer) { }

pub fn main() {
    let owned buf = Buffer { len: 0 }
    take(owned buf)
    take(owned buf)
}
