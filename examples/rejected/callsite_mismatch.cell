// EXPECT: currently-rejected
// Violates: docs/OWNERSHIP.md R15 (call-site annotation must match).
//
// `take` wants its argument moved in, and the call site asks to lend it
// instead. This is caught as of `67529a9`: the parser keeps the ownership
// keyword on a call argument, so `take(shared buf)` and `take(owned buf)` no
// longer build the identical AST node, and borrowck compares the written mode
// against the parameter's. Measured:
//
//   error: 'take' expects parameter 'b' as 'owned', but the argument is
//   passed as 'shared'

pub struct Buffer { copy len: Int }

pub fn take(owned b: Buffer) { }

pub fn main() {
    let owned buf = Buffer { len: 0 }
    take(shared buf)
}
