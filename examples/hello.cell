// Cell language example: hello.
// Ownership keywords: owned | shared | exclusive | arc | copy
//
// Status: parses and passes `cell check`. The emitted C does NOT compile:
// `Point { x: 1.0, y: 2.0 }` becomes the bare identifier `Point`, and the call
// to `add` is emitted unmangled as `add(...)` while its definition is emitted
// as `cell_add`. See docs/SPEC.md sections 6.7 and 10.2.

use std.io

pub struct Point {
    copy x: Float64
    copy y: Float64
}

pub enum Color {
    Red,
    Green,
    Blue,
}

pub fn add(shared a: Int, shared b: Int) -> Int {
    return a + b
}

pub fn main() {
    let owned p = Point { x: 1.0, y: 2.0 }
    let copy n = add(shared 40, shared 2)
    print(n)
}
