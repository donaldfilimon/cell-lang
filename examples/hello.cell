// Cell language example: hello.
// Ownership keywords: owned | shared | exclusive | arc | copy
//
// Status: parses, passes `cell check`, and the emitted C compiles and runs.
// Verified with:
//   cell emit examples/hello.cell > hello.c
//   zig cc -std=c11 -Wall -Wextra -Werror -I runtime hello.c runtime/cell_rt.c
// It prints 42.

use std.io

// `use` binds no names (SPEC 8.4), and the checker resolves identifiers, so
// anything this file calls must be declared here. Declared bodyless: an
// external symbol supplied at link time by runtime/cell_rt.c. `print` itself
// takes a String, so printing an Int uses the separate `print_int` intrinsic.
pub fn print_int(copy value: Int);

pub struct Point {
    copy x: Float64
    copy y: Float64
}

pub enum Color {
    Red,
    Green,
    Blue,
}

pub fn add(shared a: Int, shared b: Int) -> Int {
    return a + b
}

pub fn main() {
    let owned p = Point { x: 1.0, y: 2.0 }
    let copy n = add(shared 40, shared 2)
    print_int(n)
}
