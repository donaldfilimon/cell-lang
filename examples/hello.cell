// Cell language example: hello.
// Ownership keywords: owned | shared | exclusive | arc | copy
//
// Status: parses and passes `cell check`. The emitted C does NOT compile:
// 3 errors from `cc -c`, measured. The struct literal is parsed faithfully and
// then emitted as the placeholder comment
// `/*struct literal Point with 2 fields*/`, and the calls to `add` and `print`
// are emitted unmangled while the definition of `add` is emitted as `cell_add`.
// See docs/SPEC.md sections 6.7 and 10.2.

use std.io

// `use` binds no names (SPEC 8.4), and the checker now resolves identifiers, so
// anything this file calls must be declared in this file. `print` is declared
// bodyless: an external symbol supplied at link time.
pub fn print(copy value: Int);

pub struct Point {
    copy x: Float64
    copy y: Float64
}

pub enum Color {
    Red,
    Green,
    Blue,
}

pub fn add(shared a: Int, shared b: Int) -> Int {
    return a + b
}

pub fn main() {
    let owned p = Point { x: 1.0, y: 2.0 }
    let copy n = add(shared 40, shared 2)
    print(n)
}
