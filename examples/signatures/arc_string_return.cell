// The former unsafe `arc String` return-signature disagreement. HIR now
// preserves declared return ownership on functions and calls. LLVM and MLIR
// explicitly refuse this nonprimitive ARC contract before selecting a value
// ABI, while the C backend retains its existing ARC representation.
//
// This file has no `main` on purpose: it is a signature fixture, not a
// program, and nothing here is meant to run. The backend agreement gate proves
// both IR refusals are intentional rather than crashes or failed lowering.
pub fn make() -> String;
pub fn f() -> arc String { return make() }
