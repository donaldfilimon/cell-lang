// First IR cleanup slice: a simple fall-through body owns one String per
// call. The runtime counter must finish with no live allocations on all
// backends after HIR inserts the shared release.
// EXPECT-OUTPUT: 1000

pub fn print_int(copy value: Int);

pub fn once() {
    let owned s: String = "x"
}

pub fn main() {
    var copy i = 0
    while i < 1000 {
        once()
        i = i + 1
    }
    print_int(i)
}
