// A record declared inside a nested block, not a function-level `let`.
// Each call builds two owned Strings and then leaves the block.
// 1000 calls. EXPECT-OUTPUT: 1000
//
// BEFORE the nested-block release, on the post-nested-field compiler: C
// ALLOC=2000 FREE=2000 LIVE=0; LLVM and MLIR ALLOC=2000 FREE=0 LIVE=2000.
// After the block-end walk they measure ALLOC=2000 FREE=2000 LIVE=0.
// C already freed the block's locals. IR's function-end walk only sees
// direct lets of the function, so the block-end walk frees both fields.

pub struct Pair {
    owned a: String
    owned b: String
}

pub fn print_int(copy value: Int);

pub fn once(copy c: Int) {
    if c > 0 {
        let owned p: Pair = Pair { a: "aaaaaaaa", b: "bbbbbbbb" }
    }
}

pub fn main() {
    var i = 0
    while i < 1000 {
        once(1)
        i = i + 1
    }
    print_int(i)
}
