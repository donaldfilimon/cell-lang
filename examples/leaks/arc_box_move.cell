// R10 move-into-`arc`, the IMPLEMENTED positions: a whole `owned` `String` or
// list binding moved into a fresh box at `let arc`, at a direct `return`
// from a `-> arc T` function, by assignment into a whole `var arc`
// binding, as an argument to an `arc` parameter (the callee releases the
// box), and into a struct literal's `arc` field (the record's drop glue
// releases it). Not an R11 "Still broken" row: until
// 2026-09-16 both positions were refused (a loud C type error before that),
// so there was never a runtime leak to measure. It is here because the move
// is only correct while borrowck and codegen agree exactly: borrowck must
// record the source as wholly moved, and codegen must then box it
// (`isMovedOwnedBinding`) and skip its drop. If borrowck stops moving it, the
// source is freed AND boxed (a double free, which the sanitizer stage and this
// pin both see as a failure); if codegen stops skipping the drop, the same.
// If codegen stops boxing, the C does not compile. Pinned at 0 on both
// witnesses; ASan clean on the same program outside the gate.
//
// Covered: an `owned` String parameter, an `owned` list parameter and an
// `owned` String local, each returned as `arc`; and an `owned` String local
// bound with `let arc`; an `owned` String and list local each assigned
// into a `var arc` that already holds a box; an `owned` String and list
// local each passed to an `arc` parameter; and an `owned` String and list
// local each stored in a struct literal's `arc` field. NOT covered, by design: a move on only one branch
// (`if c { return p }`), which leaks the source on the path that did not
// move it because borrowck records a branch move as if it happened on every
// path. That is the pre-existing R2 behaviour of a conditional return and
// measures the same for a plain `-> String` function (50 leaks over 50
// non-returning calls in both).
//
// Status: parses, passes `cell check`. LLVM and MLIR refuse it; lives under
// examples/leaks/ so it is invisible to the top-level corpus, agreement and
// mlir-lowering loops (see examples/leaks/README.md).

pub fn print_int(copy value: Int);

pub fn box_string(owned s: String) -> arc String {
    return s
}

pub fn box_list(owned xs: [Int]) -> arc [Int] {
    return xs
}

pub fn box_local() -> arc String {
    let owned t: String = "local-string"
    return t
}

pub fn box_by_assign() {
    var arc a: String = "old-box"
    let owned p: String = "assigned-in"
    a = p
    var arc b: [Int] = [9]
    let owned xs: [Int] = [4, 5]
    b = xs
}

pub fn keep(arc s: String) {
}

pub fn keep_list(arc xs: [Int]) {
}

pub fn box_by_call() {
    let owned p: String = "passed-in"
    keep(p)
    let owned xs: [Int] = [6, 7]
    keep_list(xs)
}

pub struct Holder {
    arc s: String
    arc xs: [Int]
}

pub fn box_by_field() {
    let owned p: String = "field-in"
    let owned ys: [Int] = [8, 9]
    let owned h = Holder { s: p, xs: ys }
}

pub fn main() {
    var i = 0
    while i < 1000 {
        let owned s: String = "moved-at-return"
        let arc a = box_string(s)
        let owned xs: [Int] = [1, 2, 3]
        let arc b = box_list(xs)
        let arc c = box_local()
        let owned u: String = "moved-at-let"
        let arc d = u
        box_by_assign()
        box_by_call()
        box_by_field()
        i = i + 1
    }
    print_int(i)
}
