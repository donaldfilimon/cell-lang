// An owning String? (sub-project 4, 2026-09-17): `Some(x)` moves `x`;
// `Some(owned s)` takes the String and consumes the optional on that arm
// only; `Some(shared s)` borrows it; `Some(_)` and `None` match without
// taking it. The optional is released on every path that still holds it.
//
// Status: parses, passes `cell check`, and the emitted C compiles, links and
// runs, printing 1005210143 (see EXPECT-OUTPUT). C backend only: LLVM and
// MLIR refuse a String payload in an optional together.
// EXPECT-OUTPUT: 1005210143

pub fn print_int(copy value: Int);
pub fn str_from_int(copy v: Int) -> String;
pub fn str_len(shared s: String) -> Int;

pub fn lookup(copy n: Int) -> String? {
    if n < 0 {
        return None
    }
    return Some(str_from_int(n))
}

pub fn take_len(owned s: String) -> Int {
    return str_len(s)
}

pub fn owned_len(owned o: String?) -> Int {
    return match o {
        Some(owned s) => take_len(s),
        None => 0,
    }
}

pub fn shared_len(owned o: String?) -> Int {
    return match o {
        Some(shared s) => str_len(s),
        None => 1,
    }
}

pub fn present(owned o: String?) -> Int {
    return match o {
        Some(_) => 10,
        None => 20,
    }
}

pub fn wrap(owned s: String) -> String? {
    return Some(s)
}

pub fn main() {
    var owned o: String? = lookup(12345)
    o = lookup(-1)
    let copy a = owned_len(lookup(123))
    let copy b = shared_len(lookup(4567))
    let copy c = shared_len(lookup(-5))
    let copy d = present(lookup(9))
    let copy e = owned_len(wrap(str_from_int(99)))
    let copy f = match lookup(55555) {
        Some(owned s) => take_len(s),
        None => 0,
    }
    let copy g = match lookup(-3) {
        Some(shared s) => str_len(s),
        None => 100,
    }
    let copy h = owned_len(o)
    print_int(a + b * 10 + c * 100 + d * 1000 + e * 100000 + f * 1000000 + g * 10000000 + h)
}
