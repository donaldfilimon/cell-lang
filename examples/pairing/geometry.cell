// MODULE FILE. Pairs with geometry.body by filename stem.
//
// Status: implemented. `cell check` on this file passes as a standalone
// module. `cell check examples/pairing/geometry.body` pairs by stem and
// resolves Point / Quadrant / the function declarations from here.
//
// A module file may declare, define, or both. This one only declares, which is
// the header-shaped use the split exists for.

pub struct Point {
    copy x: Float64
    copy y: Float64
}

pub enum Quadrant { First, Second, Third, Fourth }

/// Declared here, defined in geometry.body.
pub fn distance_squared(shared a: Point, shared b: Point) -> Float64;

/// Declared here, defined in geometry.body.
pub fn quadrant_of(shared p: Point) -> Quadrant;

/// Declared here and NEVER defined. That is legal and deliberate: an external
/// symbol supplied at link time. SPEC 1.2 rule 7. This is what the whole
/// prelude is.
pub fn host_plot(shared p: Point);
