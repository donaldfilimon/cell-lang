// Ownership model demo (Rust and Swift and Zig blend).
//
// Status: parses and passes `cell check`. Move, aliasing, escape, and
// immutable-assignment rules are enforced (OWNERSHIP.md R2, R3, R5, R8, R14).
// Call-site ownership prefixes are still discarded by the parser (R15), so
// `grow(exclusive buf, ...)` is checked from the callee signature, not the
// written prefix. Retain/release for `arc` is not inserted. See docs/OWNERSHIP.md.

pub struct Buffer {
    owned data: [Byte]
    copy len: Int
}

/// shared    = immutable borrow (Rust &T, Swift borrowing)
/// exclusive = mutable borrow   (Rust &mut T, Swift inout)
/// owned     = unique owner, moves on use (Rust T, Swift consuming)
/// arc       = shared ownership by refcount (Rust Arc<T>, Swift class)
/// copy      = value semantics, duplicated not moved (Rust Copy, Swift struct)

pub fn grow(exclusive buf: Buffer, shared extra: Int) {
    // An exclusive borrow allows mutation of the caller's buffer, including
    // field writes (OWNERSHIP.md R14). The same write through a `shared`
    // or immutable `let` is rejected; see
    // examples/rejected/field_assign_immutable.cell.
    let copy new_len = buf.len + extra
    buf.len = new_len
}

pub fn share_name(arc name: String) -> arc String {
    // A returned arc is returned already retained. No retain is emitted.
    return name
}

pub fn take(owned b: Buffer) {
    // b is moved in. The caller may not use it afterward (OWNERSHIP.md R2).
    // Enforced: examples/rejected/use_after_move.cell is currently-rejected.
}

pub fn read_only(shared b: Buffer) -> Int {
    return b.len
}

pub fn main() {
    let owned buf = Buffer { data: [], len: 0 }

    // Call-site ownership prefixes parse and are then DISCARDED before the AST
    // is built, so nothing can check them against the parameter (R15). Measured
    // C is `cell_grow(&buf, 16)`: mangling and the exclusive address-of come
    // from the callee signature, not the written prefix. See SPEC 4.2.
    grow(exclusive buf, shared 16)

    let copy n = read_only(shared buf)

    // After this, `buf` is dead under rule R2. A second use is rejected; see
    // examples/rejected/use_after_move.cell.
    take(owned buf)
}
