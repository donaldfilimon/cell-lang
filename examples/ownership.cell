// Ownership model demo (Rust and Swift and Zig blend).
//
// Status: parses and passes `cell check`. NONE of the ownership annotations
// below are enforced. There is no borrow checker. See docs/OWNERSHIP.md for
// the numbered rules a checker must enforce, and docs/SPEC.md section 4 for
// what each annotation means.
//
// The emitted C for this file does not compile: 5 errors from `cc -c`,
// including `buf.len` on a void* parameter and unmangled calls to `grow` and
// `take`. Measured. See SPEC 6.3 and 10.2.

pub struct Buffer {
    owned data: [Byte]
    copy len: Int
}

/// shared    = immutable borrow (Rust &T, Swift borrowing)
/// exclusive = mutable borrow   (Rust &mut T, Swift inout)
/// owned     = unique owner, moves on use (Rust T, Swift consuming)
/// arc       = shared ownership by refcount (Rust Arc<T>, Swift class)
/// copy      = value semantics, duplicated not moved (Rust Copy, Swift struct)

pub fn grow(exclusive buf: Buffer, shared extra: Int) {
    // An exclusive borrow allows mutation of the caller's buffer.
    //
    // NOT CHECKED: the mutability check keys on the joined path "buf.len",
    // which never matches the symbol "buf", so field assignment is never
    // checked at all. This passes for the wrong reason. OWNERSHIP.md R14.
    let copy new_len = buf.len + extra
    buf.len = new_len
}

pub fn share_name(arc name: String) -> arc String {
    // A returned arc is returned already retained. No retain is emitted.
    return name
}

pub fn take(owned b: Buffer) {
    // b is moved in. The caller may not use it afterward (OWNERSHIP.md R2).
    // NOT CHECKED: examples/rejected/use_after_move.cell shows the violation
    // being accepted today.
}

pub fn read_only(shared b: Buffer) -> Int {
    return b.len
}

pub fn main() {
    let owned buf = Buffer { data: [], len: 0 }

    // Call-site ownership prefixes parse and are then DISCARDED before the AST
    // is built, so nothing can check them against the parameter. Measured:
    // this line emits `grow(buf, 16)`. See SPEC 4.2 and OWNERSHIP.md R15.
    grow(exclusive buf, shared 16)

    let copy n = read_only(shared buf)

    // After this, `buf` is dead under rule R2. Nothing enforces that.
    take(owned buf)
}
